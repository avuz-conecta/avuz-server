diff --git a/src/mixins/JumpsMixin.ts b/src/mixins/JumpsMixin.ts
new file mode 100644
index 0000000..8347b6d
--- /dev/null
+++ b/src/mixins/JumpsMixin.ts
@@ -0,0 +1,307 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+
+import type { InjectionKey } from 'vue'
+import type {
+	FormsJump,
+	FormsJumpTarget,
+	FormsQuestion,
+} from '../models/Entities.d.ts'
+import type { JumpAnswer, JumpIssues } from '../utils/Jumps.ts'
+
+import { showConfirmation } from '@nextcloud/dialogs'
+import { translate as t } from '@nextcloud/l10n'
+import { defineComponent } from 'vue'
+import {
+	canDecideByAnswer,
+	getJumps,
+	isJumpOf,
+	JUMP_TARGET_SUBMIT,
+	jumpsPastFollowingQuestion,
+	QUESTION_TYPES_WITH_GOTO,
+	QUESTION_TYPES_WITH_NEXT,
+} from '../utils/Jumps.ts'
+
+/** The jump issues of the form, see `getJumpIssues()`, provided by the editor */
+export const FORM_JUMP_ISSUES_KEY: InjectionKey<JumpIssues> =
+	Symbol('formJumpIssues')
+
+/** The questions of the form in their order, provided by the editor */
+export const FORM_QUESTIONS_KEY: InjectionKey<FormsQuestion[]> =
+	Symbol('formQuestions')
+
+export interface JumpTargetOption {
+	id: FormsJumpTarget | null
+	label: string
+}
+
+/**
+ * The jumps of a question in the editor: the target per answer (`goTo`) and after the question (`next`).
+ * Changes are kept locally and saved as complete lists through `saveJumpSettings()` of the question.
+ * Port of upstream's `useJumps()` (nextcloud/forms#3833) to the options API.
+ */
+export default defineComponent({
+	inject: {
+		jumpFormQuestions: {
+			from: FORM_QUESTIONS_KEY,
+			default: () => [],
+		},
+		jumpFormIssues: {
+			from: FORM_JUMP_ISSUES_KEY,
+			default: null,
+		},
+	},
+
+	data() {
+		return {
+			jumpGoTo: [] as FormsJump[],
+			jumpNext: null as FormsJumpTarget | null,
+			jumpsEnabled: false,
+		}
+	},
+
+	computed: {
+		canGoTo(): boolean {
+			return QUESTION_TYPES_WITH_GOTO.includes(String(this.type))
+		},
+
+		canNext(): boolean {
+			return QUESTION_TYPES_WITH_NEXT.includes(String(this.type))
+		},
+
+		jumpPosition(): number {
+			return (this.jumpFormQuestions as FormsQuestion[]).findIndex(
+				(question) => question.id === this.id,
+			)
+		},
+
+		jumpTargetOptions(): JumpTargetOption[] {
+			const position = this.jumpPosition
+			return [
+				{ id: null, label: t('forms', 'Next question') },
+				...(this.jumpFormQuestions as FormsQuestion[])
+					.slice(position + 1)
+					.map((question, offset) => ({
+						id: question.id,
+						label: t(
+							'forms',
+							'Question {number}: {title}',
+							{
+								number: position + offset + 2,
+								title:
+									question.text?.trim()
+									|| t('forms', 'Untitled question'),
+							},
+							{ escape: false, sanitize: false },
+						),
+					})),
+				{ id: JUMP_TARGET_SUBMIT, label: t('forms', 'End of the form') },
+			]
+		},
+
+		jumpWarnings(): string[] {
+			const issues = this.jumpFormIssues as JumpIssues | null
+			if (!issues) {
+				return []
+			}
+			return [
+				...(issues.broken.has(this.id)
+					? [
+							t(
+								'forms',
+								'A jump of this question goes to a question that was deleted or now comes before it. Respondents go to the next question instead.',
+							),
+						]
+					: []),
+				...(issues.unreachable.has(this.id)
+					? [
+							t(
+								'forms',
+								'No respondent reaches this question, because the jumps of the questions before it always skip it.',
+							),
+						]
+					: []),
+			]
+		},
+
+		jumpHint(): string {
+			if (!this.canGoTo || this.isRequired || this.jumpGoTo.length === 0) {
+				return ''
+			}
+			const questions = this.jumpFormQuestions as FormsQuestion[]
+			const question = questions[this.jumpPosition]
+			return question !== undefined
+				&& canDecideByAnswer(question)
+				&& jumpsPastFollowingQuestion(
+					this.jumpGoTo,
+					!!this.extraSettings?.allowOtherAnswer,
+					this.jumpPosition,
+					new Map(
+						questions.map((question, index) => [question.id, index]),
+					),
+					questions.length,
+				)
+				? t(
+						'forms',
+						'Respondents see the questions after this one only once they answer it. If they leave it empty, they can submit the form without the questions after it, even required ones. Make it required to prevent this.',
+					)
+				: ''
+		},
+
+		/**
+		 * The jumps of the question, as the prop `jumps` of `Question` and for the jump selects of the options
+		 */
+		jumps() {
+			return {
+				canGoTo: this.canGoTo,
+				canNext: this.canNext,
+				enabled: this.jumpsEnabled,
+				showTargets: !this.readOnly && this.canGoTo && this.jumpsEnabled,
+				showNext: !this.readOnly && this.canNext && this.jumpsEnabled,
+				nextLabel: t('forms', 'After question {number}', {
+					number: this.jumpPosition + 1,
+				}),
+				warnings: this.jumpWarnings,
+				hint: this.jumpHint,
+				next: this.jumpNext,
+				targetOptions: this.jumpTargetOptions,
+				getTarget: this.getJumpTargetOf,
