From f949fb3ab50577618355f23b1203abdd3c526b3c Mon Sep 17 00:00:00 2001
From: Patrick Rezende <tricio777@gmail.com>
Date: Mon, 23 Nov 2026 10:44:30 -0300
Subject: [PATCH 7/7] fix: jump select as tall as the answer field

The select box was 2px taller than the answer input (inner row plus
padding and border) and had a 4px bottom margin against the input's 3px,
so the tops never lined up. Its height now follows --default-clickable-area
like the input, with the same bottom margin. The select rules used a
nc-select class the root does not carry, so they never applied; they
target the root's real classes now, keeping the 260px width it showed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/components/Questions/JumpTargetSelect.vue | 21 ++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/src/components/Questions/JumpTargetSelect.vue b/src/components/Questions/JumpTargetSelect.vue
index d845971..b2c3e2e 100644
--- a/src/components/Questions/JumpTargetSelect.vue
+++ b/src/components/Questions/JumpTargetSelect.vue
@@ -99,11 +99,26 @@ export default defineComponent({
 
 <style lang="scss" scoped>
 .jump-target-select {
-	flex: 0 0 220px;
+	// 260px = the width NcSelect enforced before its min-width was lifted, so long question titles stay readable.
+	flex: 0 0 260px;
 }
 
-.jump-target-select.nc-select.v-select {
+.jump-target-select.v-select.select {
 	min-width: 0;
+	// The answer field (a core input) has a 3px block margin; match it so the bottoms line up.
+	margin-block-end: 3px;
+}
+
+// Same height as the answer field next to it (an input of --default-clickable-area),
+// so both boxes line up at the top and the bottom.
+.jump-target-select :deep(.vs__dropdown-toggle) {
+	box-sizing: border-box;
+	height: var(--default-clickable-area);
+	min-height: 0;
+}
+
+.jump-target-select :deep(.vs__selected-options) {
+	min-height: 0;
 }
 
 .jump-target-select__label {
@@ -124,7 +139,7 @@ export default defineComponent({
 		flex: 1 1 50%;
 	}
 
-	.jump-target-select.nc-select.v-select {
+	.jump-target-select.v-select.select {
 		margin-inline-start: -12px;
 	}
 }
