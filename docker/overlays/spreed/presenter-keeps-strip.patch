 					isStripeOpen: false,
 					clearLast: false,
+					isAutomatic: true, // AVUZ-PRESENTER-STRIP (Deck #503)
 				})
 			} else {
 				this.callViewStore.startPresentation(this.token)
@@ -772,6 +777,7 @@ export default {
 				isGrid: false,
 				isStripeOpen: false,
