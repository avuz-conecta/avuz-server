diff --git a/src/utils/whatsapp.js b/src/utils/whatsapp.js
new file mode 100644
index 0000000..019c1e0
--- /dev/null
+++ b/src/utils/whatsapp.js
@@ -0,0 +1,74 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Avuz Conecta
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+
+// AVUZ-266: WhatsApp button next to phone numbers
+const BRAZIL_COUNTRY_CODE = '55'
+const BRAZIL_NATIONAL_LENGTHS = [10, 11]
+const INTERNATIONAL_PREFIX = '00'
+const TRUNK_PREFIX = '0'
+const MIN_DIGITS = 8
+const EXTENSION_SEPARATOR = /[;,]|\s*(?:x|ext\.?|ramal)\s*\d/i
+const WHATSAPP_PHONE_TYPES = ['CELL', 'HOME', 'WORK', 'VOICE', 'OTHER', 'TEXT']
+const CUSTOM_LABEL_SUFFIX = 'X-ABLABEL'
+
+/**
+ * Digits wa.me expects: country code + number, nothing else.
+ * "+" or "00" means the country code is already there. Otherwise a number
+ * with 10 or 11 digits (after a trunk "0") is Brazilian and gets 55.
+ *
+ * @param {string} phone the TEL value as typed
+ * @return {string|null} null when fewer than 8 digits are left
+ */
+export function normalizeWhatsAppNumber(phone) {
+	const number = String(phone ?? '').trim().replace(/^tel:/i, '').split(EXTENSION_SEPARATOR)[0].trim()
+	const digits = number.replace(/\D/g, '')
+	if (digits.length < MIN_DIGITS) {
+		return null
+	}
+	if (number.startsWith('+')) {
+		return digits
+	}
+	if (digits.startsWith(INTERNATIONAL_PREFIX)) {
+		return digits.slice(INTERNATIONAL_PREFIX.length)
+	}
+	const national = digits.startsWith(TRUNK_PREFIX) ? digits.slice(TRUNK_PREFIX.length) : digits
+	if (BRAZIL_NATIONAL_LENGTHS.includes(national.length)) {
+		return `${BRAZIL_COUNTRY_CODE}${national}`
+	}
+	return digits
+}
+
+/**
+ * @param {string} phone the TEL value as typed
+ * @return {string|null} null when the number can't be on WhatsApp
+ */
+export function toWhatsAppUrl(phone) {
+	const number = normalizeWhatsAppNumber(phone)
+	if (number === null) {
+		return null
+	}
+	return `https://wa.me/${number}`
+}
+
+/**
+ * Fax, pager, car and other non-chat lines get no button. Untyped numbers
+ * and custom labels do.
+ *
+ * @param {{id: string}|null|undefined} phoneType the TEL type option ({ id: 'WORK,VOICE', name })
+ * @return {boolean}
+ */
+export function isWhatsAppPhoneType(phoneType) {
+	if (!phoneType) {
+		return true
+	}
+	const id = String(phoneType.id ?? '').toUpperCase()
+	if (id.endsWith(CUSTOM_LABEL_SUFFIX)) {
+		return true
+	}
+	return id.split(',')
+		.map((type) => type.trim())
+		.filter((type) => type && type !== 'PREF')
+		.every((type) => WHATSAPP_PHONE_TYPES.includes(type))
+}
diff --git a/tests/javascript/utils/whatsapp.test.js b/tests/javascript/utils/whatsapp.test.js
new file mode 100644
index 0000000..b118c30
