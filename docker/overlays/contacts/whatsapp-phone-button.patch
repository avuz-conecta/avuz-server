+++ b/tests/javascript/utils/whatsapp.test.js
@@ -0,0 +1,91 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Avuz Conecta
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+
+import { isWhatsAppPhoneType, normalizeWhatsAppNumber, toWhatsAppUrl } from '../../../src/utils/whatsapp.js'
+
+describe('utils/whatsapp', () => {
+	describe('normalizeWhatsAppNumber', () => {
+		describe('with a country code', () => {
+			it.each([
+				['+55 (11) 98765-4321', '5511987654321'],
+				['+1 415 555 0100', '14155550100'],
+				['+351 912 345 678', '351912345678'],
+				['00351 912 345 678', '351912345678'],
+				['tel:+55-11-98765-4321', '5511987654321'],
+			])('turns %p into %p', (phone, expected) => {
+				expect(normalizeWhatsAppNumber(phone)).toBe(expected)
+			})
+		})
+
+		describe('without a country code', () => {
+			it.each([
+				['(11) 98765-4321', '5511987654321'],
+				['11 3456-7890', '551134567890'],
+				['(54) 92367-5120', '5554923675120'],
+				['054 92367-5120', '5554923675120'],
+				['011 3456-7890', '551134567890'],
+				['5511987654321', '5511987654321'],
+			])('turns %p into %p', (phone, expected) => {
+				expect(normalizeWhatsAppNumber(phone)).toBe(expected)
+			})
+		})
+
+		describe('with an extension', () => {
+			it.each([
+				['(11) 3456-7890 ramal 12', '551134567890'],
+				['(11) 3456-7890 x12', '551134567890'],
+				['(11) 3456-7890 ext. 12', '551134567890'],
+				['+55 11 3456-7890;ext=12', '551134567890'],
+			])('drops the extension of %p', (phone, expected) => {
+				expect(normalizeWhatsAppNumber(phone)).toBe(expected)
+			})
+		})
+
+		it.each(['abc', '', '190', '1234567', 'ramal 12345678', null, undefined])('returns null for %p', (phone) => {
+			expect(normalizeWhatsAppNumber(phone)).toBeNull()
+		})
+	})
+
+	describe('toWhatsAppUrl', () => {
+		it('builds a wa.me link from the normalized number', () => {
+			expect(toWhatsAppUrl('(11) 98765-4321')).toBe('https://wa.me/5511987654321')
+		})
+
+		it('returns null when the number is too short', () => {
+			expect(toWhatsAppUrl('190')).toBeNull()
+		})
+	})
+
+	describe('isWhatsAppPhoneType', () => {
+		it.each([
+			null,
+			undefined,
+			{ id: '' },
+			{ id: 'CELL' },
+			{ id: 'HOME,VOICE' },
+			{ id: 'WORK,CELL' },
+			{ id: 'VOICE' },
+			{ id: 'pref,cell' },
+			{ id: 'OTHER' },
+			{ id: 'TEXT' },
+			{ id: 'ITEM1.X-ABLABEL' },
+		])('allows %p', (phoneType) => {
+			expect(isWhatsAppPhoneType(phoneType)).toBe(true)
+		})
+
+		it.each([
+			{ id: 'FAX' },
+			{ id: 'HOME,FAX' },
+			{ id: 'WORK,FAX' },
+			{ id: 'PAGER' },
+			{ id: 'WORK,PAGER' },
+			{ id: 'CAR' },
+			{ id: 'MODEM' },
+			{ id: 'TEXTPHONE' },
+		])('rejects %p', (phoneType) => {
+			expect(isWhatsAppPhoneType(phoneType)).toBe(false)
+		})
+	})
+})
