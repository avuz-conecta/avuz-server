diff --git a/tests/javascript/unit/components/AppNavigation/Settings.test.js b/tests/javascript/unit/components/AppNavigation/Settings.test.js
new file mode 100644
index 0000000..5a8918f
--- /dev/null
+++ b/tests/javascript/unit/components/AppNavigation/Settings.test.js
@@ -0,0 +1,93 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Avuz Conecta
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+
+import { createPinia, PiniaVuePlugin, setActivePinia } from 'pinia'
+import Vue from 'vue'
+import Settings from '../../../../../src/components/AppNavigation/Settings.vue'
+import { getDefaultCalendarObject } from '../../../../../src/models/calendar.js'
+import { getDefaultPrincipalObject } from '../../../../../src/models/principal.js'
+import useCalendarsStore from '../../../../../src/store/calendars.js'
+import usePrincipalsStore from '../../../../../src/store/principals.js'
+
+const PERSONAL_CALENDAR = getDefaultCalendarObject({
+	id: 'personal',
+	displayName: 'Pessoal',
+	url: '/remote.php/dav/calendars/bri/personal/',
+})
+const WORK_CALENDAR = getDefaultCalendarObject({
+	id: 'work',
+	displayName: 'Trabalho',
+	url: '/remote.php/dav/calendars/bri/work/',
+})
+
+Vue.use(PiniaVuePlugin)
+Vue.prototype.$t = (_app, text) => text
+Vue.prototype.t = (_app, text) => text
+globalThis.t = (_app, text) => text
+
+async function mountSettings({ principal }) {
+	const pinia = createPinia()
+	setActivePinia(pinia)
+	useCalendarsStore().calendars = [PERSONAL_CALENDAR, WORK_CALENDAR]
+	if (principal) {
+		const principalsStore = usePrincipalsStore()
+		principalsStore.addPrincipalMutation({ principal })
+		principalsStore.currentUserPrincipal = principal.id
+	}
+
+	const renderErrors = []
+	Vue.config.errorHandler = (error) => renderErrors.push(error)
+	const SettingsConstructor = Vue.extend(Settings)
+	const settings = new SettingsConstructor({ pinia }).$mount()
+	await Vue.nextTick()
+	Vue.config.errorHandler = undefined
+
+	return { settings, renderErrors }
+}
+
+describe('components/AppNavigation/Settings', () => {
+	describe('default calendar for incoming invitations', () => {
+		describe('before the current-user principal is loaded', () => {
+			it('renders without errors', async () => {
+				const { renderErrors } = await mountSettings({ principal: undefined })
+
+				expect(renderErrors).toEqual([])
+			})
+
+			it('falls back to the first writable calendar', async () => {
+				const { settings } = await mountSettings({ principal: undefined })
+
+				expect(settings.defaultCalendar).toBe(PERSONAL_CALENDAR)
+			})
+		})
+
+		describe('with a current-user principal', () => {
+			it('picks the calendar set as schedule default', async () => {
+				const principal = getDefaultPrincipalObject({
+					id: 'bri',
+					url: '/remote.php/dav/principals/users/bri/',
+					scheduleDefaultCalendarUrl: WORK_CALENDAR.url,
+				})
+
+				const { settings, renderErrors } = await mountSettings({ principal })
+
+				expect(renderErrors).toEqual([])
+				expect(settings.defaultCalendar).toBe(WORK_CALENDAR)
+			})
+
+			it('falls back to the first writable calendar when the schedule default is gone', async () => {
+				const principal = getDefaultPrincipalObject({
+					id: 'bri',
+					url: '/remote.php/dav/principals/users/bri/',
+					scheduleDefaultCalendarUrl: '/remote.php/dav/calendars/bri/deleted/',
+				})
+
+				const { settings } = await mountSettings({ principal })
+
+				expect(settings.defaultCalendar).toBe(PERSONAL_CALENDAR)
+			})
+		})
+	})
+})
