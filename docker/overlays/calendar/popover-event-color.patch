diff --git a/tests/javascript/unit/components/Editor/Properties/PropertyColor.test.js b/tests/javascript/unit/components/Editor/Properties/PropertyColor.test.js
new file mode 100644
index 0000000..5ef1c84
--- /dev/null
+++ b/tests/javascript/unit/components/Editor/Properties/PropertyColor.test.js
@@ -0,0 +1,100 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Avuz Conecta
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+
+import Vue from 'vue'
+import PropertyColor from '../../../../../../src/components/Editor/Properties/PropertyColor.vue'
+import { getRFCProperties } from '../../../../../../src/models/rfcProps.js'
+
+const CALENDAR_BLUE = '#0082c9'
+const CALENDAR_RED = '#e9322d'
+const EVENT_GREEN = '#008000'
+
+Vue.prototype.$t = (_app, text) => text
+
+async function mountPropertyColor(propsData) {
+	const PropertyColorConstructor = Vue.extend(PropertyColor)
+	const propertyColor = new PropertyColorConstructor({
+		propsData: {
+			propModel: getRFCProperties().color,
+			isReadOnly: false,
+			...propsData,
+		},
+	}).$mount()
+	await Vue.nextTick()
+	return propertyColor
+}
+
+function previewColor(propertyColor) {
+	return propertyColor.$el.querySelector('.property-color__color-preview').style.backgroundColor
+}
+
+function rgb(hex) {
+	const element = document.createElement('div')
+	element.style.backgroundColor = hex
+	return element.style.backgroundColor
+}
+
+describe('components/Editor/Properties/PropertyColor', () => {
+	describe('when the event has no custom color', () => {
+		it('previews the calendar color', async () => {
+			const propertyColor = await mountPropertyColor({ calendarColor: CALENDAR_BLUE, value: null })
+
+			expect(previewColor(propertyColor)).toEqual(rgb(CALENDAR_BLUE))
+		})
+
+		it('follows the calendar color when the user picks another calendar', async () => {
+			const propertyColor = await mountPropertyColor({ calendarColor: CALENDAR_BLUE, value: null })
+
+			propertyColor.$props.calendarColor = CALENDAR_RED
+			await Vue.nextTick()
+
+			expect(previewColor(propertyColor)).toEqual(rgb(CALENDAR_RED))
+		})
+
+		it('hides the reset button', async () => {
+			const propertyColor = await mountPropertyColor({ calendarColor: CALENDAR_BLUE, value: null })
+
+			expect(propertyColor.$el.querySelectorAll('button')).toHaveLength(1)
+		})
+	})
+
+	describe('when the event has a custom color', () => {
+		it('previews the event color', async () => {
+			const propertyColor = await mountPropertyColor({ calendarColor: CALENDAR_BLUE, value: EVENT_GREEN })
+
+			expect(previewColor(propertyColor)).toEqual(rgb(EVENT_GREEN))
+		})
+
+		it('keeps the event color when the user picks another calendar', async () => {
+			const propertyColor = await mountPropertyColor({ calendarColor: CALENDAR_BLUE, value: EVENT_GREEN })
+
+			propertyColor.$props.calendarColor = CALENDAR_RED
+			await Vue.nextTick()
+
+			expect(previewColor(propertyColor)).toEqual(rgb(EVENT_GREEN))
+		})
+
+		it('emits null and falls back to the calendar color on reset', async () => {
+			const propertyColor = await mountPropertyColor({ calendarColor: CALENDAR_BLUE, value: EVENT_GREEN })
+			const emitted = []
+			propertyColor.$on('update:value', (color) => emitted.push(color))
+
+			propertyColor.$el.querySelectorAll('button')[1].click()
+			await Vue.nextTick()
+
+			expect(emitted).toEqual([null])
+			expect(previewColor(propertyColor)).toEqual(rgb(CALENDAR_BLUE))
+		})
+	})
+
+	describe('when read-only', () => {
+		it('shows the color without a picker', async () => {
+			const propertyColor = await mountPropertyColor({ calendarColor: CALENDAR_BLUE, value: EVENT_GREEN, isReadOnly: true })
+
+			expect(propertyColor.$el.querySelector('button')).toBeNull()
+			expect(previewColor(propertyColor)).toEqual(rgb(EVENT_GREEN))
+		})
+	})
+})
