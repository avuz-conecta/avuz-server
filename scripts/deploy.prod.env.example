# PRODUCTION Portainer CE API access — used by scripts/deploy-prod.sh.
# Copy to deploy.prod.env (gitignored) and fill in real values.
# Use a SEPARATE token from staging (own account/permissions = own blast radius).
PORTAINER_URL=https://<prod-portainer-ip>:9443
PORTAINER_TOKEN=ptr_replace_me_prod
PORTAINER_INSECURE=1
