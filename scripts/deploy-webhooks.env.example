# Portainer redeploy webhooks — stack=url, one per line.
# Copy to deploy-webhooks.env (gitignored) and fill in real URLs.
#
# Get a URL: Portainer → the client's stack → Webhooks → enable → copy.
# Treat these as SECRETS — anyone with a URL can redeploy that stack.
#
# grupo-vidalar=https://portainer.avuz.app/api/stacks/webhooks/00000000-0000-0000-0000-000000000000
# raiven=https://portainer.avuz.app/api/stacks/webhooks/00000000-0000-0000-0000-000000000000
