# ============================================
# Base image with PHP extensions and runtime packages
# Rebuild only when PHP version or extensions change
# ============================================
FROM php:8.3-fpm-alpine

# Install php-extension-installer
ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN chmod +x /usr/local/bin/install-php-extensions

# Install all PHP extensions
RUN install-php-extensions \
  gd zip intl pdo pdo_pgsql pgsql opcache bcmath \
  gmp bz2 exif pcntl ldap sysvsem \
  redis imagick apcu

# Install runtime packages
RUN apk add --no-cache \
  nginx supervisor postgresql-client redis ffmpeg \
  curl bash git nodejs npm

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Configure PHP-FPM for performance
RUN { \
  echo '[www]'; \
  echo 'user = www-data'; \
  echo 'group = www-data'; \
  echo 'listen = 127.0.0.1:9000'; \
  echo 'pm = dynamic'; \
  echo 'pm.max_children = 50'; \
  echo 'pm.start_servers = 10'; \
  echo 'pm.min_spare_servers = 5'; \
  echo 'pm.max_spare_servers = 15'; \
  echo 'pm.max_requests = 500'; \
  echo 'pm.process_idle_timeout = 10s'; \
  echo 'catch_workers_output = yes'; \
  echo 'clear_env = no'; \
  echo 'php_admin_value[error_reporting] = E_ALL & ~E_WARNING'; \
  } > /usr/local/etc/php-fpm.d/www.conf

# Configure PHP for Nextcloud
RUN { \
  echo 'opcache.enable=1'; \
  echo 'opcache.interned_strings_buffer=32'; \
  echo 'opcache.max_accelerated_files=10000'; \
  echo 'opcache.memory_consumption=256'; \
  echo 'opcache.save_comments=1'; \
  echo 'opcache.revalidate_freq=60'; \
  echo 'opcache.jit=1255'; \
  echo 'opcache.jit_buffer_size=128M'; \
  echo 'opcache.validate_timestamps=0'; \
  } > /usr/local/etc/php/conf.d/opcache-recommended.ini

RUN { \
  echo 'memory_limit=512M'; \
  echo 'upload_max_filesize=10G'; \
  echo 'post_max_size=10G'; \
  echo 'max_execution_time=3600'; \
  echo 'max_input_time=3600'; \
  echo 'date.timezone=UTC'; \
  echo 'expose_php=Off'; \
  echo 'error_reporting=E_ALL & ~E_WARNING'; \
  } > /usr/local/etc/php/conf.d/nextcloud.ini

# Create directories
RUN mkdir -p /var/log/supervisor /run/nginx /var/cache/nginx \
  && chown -R www-data:www-data /var/cache/nginx

WORKDIR /var/www/html
